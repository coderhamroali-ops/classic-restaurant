# Скопируйте в .env и поменяйте значения
PORT=4000
CORS_ORIGIN=http://localhost:3000

DB_HOST=localhost
# 5440 — порт базы из docker-compose (5432 часто занят установленным PostgreSQL)
DB_PORT=5440
DB_USER=classic
DB_PASSWORD=classic
DB_NAME=classic
# true — TypeORM сам создаёт таблицы по сущностям (удобно для разработки)
DB_SYNC=true

# Длинная случайная строка; в продакшене обязательно своя
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Первый администратор, создаётся командой npm run seed
SEED_ADMIN_EMAIL=admin@classic.local
SEED_ADMIN_PASSWORD=admin12345
